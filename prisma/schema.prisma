// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma v7+: URL dikonfigurasi via prisma.config.ts (untuk CLI: migrate, generate)
  // Runtime connection dikelola oleh PrismaPg adapter + pg.Pool di src/lib/prisma.ts
  // yang membaca DATABASE_URL langsung dari process.env
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  ADVERTISER
}

enum AdSlotCategory {
  WEBSITE
  NEWSLETTER
  PODCAST
  SOCIAL_MEDIA
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  SCHEDULED
  LIVE
  COMPLETED
  REJECTED
}

enum PaymentStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ProofType {
  SCREENSHOT
  LIVE_LINK
}

// ============================================================
// MODELS
// ============================================================

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phoneNumber  String?   @map("phone_number") @db.VarChar(20)
  role         Role      @default(ADVERTISER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  bookings          Booking[] @relation("AdvertiserBookings")
  verifiedPayments  Payment[] @relation("AdminVerifications")

  @@map("users")
}

model AdSlot {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(150)
  category        AdSlotCategory
  description     String?        @db.Text
  pricePerDay     Decimal        @map("price_per_day") @db.Decimal(12, 2)
  dimensionsSpec  String?        @map("dimensions_spec") @db.VarChar(100)
  allowedFormats  String         @map("allowed_formats") @db.VarChar(100)
  maxFileSizeMb   Int            @default(5) @map("max_file_size_mb")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  bookings Booking[]

  @@unique([title])
  @@map("ad_slots")
}

model Booking {
  id              Int           @id @default(autoincrement())
  bookingCode     String        @unique @map("booking_code") @db.VarChar(25)
  userId          Int           @map("user_id")
  adSlotId        Int           @map("ad_slot_id")
  campaignName    String        @map("campaign_name") @db.VarChar(150)
  brandName       String        @map("brand_name") @db.VarChar(100)
  targetUrl       String?       @map("target_url") @db.VarChar(255)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  totalPrice      Decimal       @map("total_price") @db.Decimal(12, 2)
  status          BookingStatus @default(PENDING_PAYMENT)
  rejectionReason String?       @map("rejection_reason") @db.Text
  notes           String?       @map("notes") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user     User       @relation("AdvertiserBookings", fields: [userId], references: [id])
  adSlot   AdSlot     @relation(fields: [adSlotId], references: [id])
  assets   AdAsset[]
  payment  Payment?
  proofs   ProofOfPerformance[]

  @@index([status])
  @@index([adSlotId, startDate, endDate])
  @@map("bookings")
}

model AdAsset {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  filePath   String   @map("file_path") @db.VarChar(500)
  fileType   String   @map("file_type") @db.VarChar(50)
  fileSizeKb Int      @map("file_size_kb")
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("ad_assets")
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique @map("booking_id")
  amount        Decimal       @db.Decimal(12, 2)
  bankName      String        @map("bank_name") @db.VarChar(50)
  senderName    String        @map("sender_name") @db.VarChar(100)
  proofFilePath String        @map("proof_file_path") @db.VarChar(500)
  status        PaymentStatus @default(UNVERIFIED)
  verifiedAt    DateTime?     @map("verified_at")
  verifiedBy    Int?          @map("verified_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedByUser User?   @relation("AdminVerifications", fields: [verifiedBy], references: [id])

  @@map("payments")
}

model ProofOfPerformance {
  id         Int       @id @default(autoincrement())
  bookingId  Int       @map("booking_id")
  proofType  ProofType @map("proof_type")
  contentUrl String    @map("content_url") @db.Text
  notes      String?   @db.Text
  uploadedAt DateTime  @default(now()) @map("uploaded_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("proof_of_performances")
}
